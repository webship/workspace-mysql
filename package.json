{
  "name": "@webship.co/workspace-mysql",
  "version": "1.0.0",
  "description": "MySQL for Webship Workspace: the DATABASE menu on every project whose database is MySQL (a console in a screen, tables and sizes, an export into the backups folder, an import of a dump, the statements running now, the connection details, and Adminer and phpMyAdmin on DDEV), and its tool, cmd-tools-mysql.sh, on DDEV and on a compose file of the project's own. It carries its AI items, each placed in the workspace folder of its kind: an agent, a skill, a command and a prompt. An engine of @webship.co/workspace-database.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-mysql.git"
  },
  "files": [
    "dist/src",
    "ai",
    "commands",
    "config",
    "docs",
    "features",
    "scripts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "mysql",
    "label": "MySQL",
    "family": "databases",
    "summary": "The DATABASE menu of a project whose database is MySQL: its console, tables and sizes, export and import, web admin",
    "settingsFile": "plugin.mysql.settings.yml",
    "settingsTemplate": "config/plugin.mysql.settings.yml",
    "labels": "config/settings.labels.yml",
    "needs": {
      "plugins": [
        [
          "dev",
          "test",
          "demos",
          "sandboxes",
          "projects"
        ],
        "ai-agents",
        "ai-skills",
        "ai-commands",
        "ai-prompts"
      ]
    },
    "suggests": {
      "commands": [
        {
          "command": "docker",
          "hint": "https://docs.docker.com/engine/install/",
          "for": "cmd-tools-mysql.sh, on a compose file of the project's own"
        }
      ]
    },
    "typeActions": {
      "database": [
        "sites"
      ]
    },
    "commands": {
      "types": [
        "sites"
      ],
      "files": [
        "commands/cmd-tools-mysql.sh"
      ]
    },
    "scripts": {
      "functions": [
        "scripts/functions/fun-mysql.sh"
      ],
      "args": [
        "scripts/args/arg-mysql.sh"
      ]
    },
    "ai": {
      "agents": [
        "ai/agents/mysql-helper.md"
      ],
      "skills": [
        "ai/skills/mysql-database"
      ],
      "commands": [
        "ai/commands/mysql-sizes.md"
      ],
      "prompts": [
        "ai/prompts/mysql-dump-and-check.md"
      ]
    },
    "features": [
      "features/mysql.feature"
    ]
  },
  "dependencies": {
    "@webship.co/workspace-database": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.12",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
